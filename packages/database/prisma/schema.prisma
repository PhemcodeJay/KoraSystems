// ============================================================================
// Neobank — Crypto Wallets
// ============================================================================

/// A per-asset crypto balance held by a user.
///
/// One row per (user, asset), enforced by `@@unique([userId, symbol])`. The
/// Neobank routes top up and debit a balance by upserting on that compound
/// key, so two concurrent deposits of the same asset cannot both read the
/// old balance and write back a value that loses one of them.
model CryptoWallet {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ticker as traded: BTC, ETH, SOL, USDT, USDC.
  symbol    String
  /// 8 decimal places — the precision a crypto balance actually needs, and
  /// the same scale as `Investment.quantity`.
  balance   Decimal  @default(0) @db.Decimal(18, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, symbol])
  @@index([userId])
  @@map("crypto_wallets")
  @@schema("kora")
}

