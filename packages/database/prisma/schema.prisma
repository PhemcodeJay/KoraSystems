  body     String
  // Forecast: 7d/30d/90d, daysUntilStockout, recommendedOrder, confidence
  payload  Json?
  priority Int         @default(3)
  isRead   Boolean     @default(false) @map("is_read")
  model    String?

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([smeId, type, createdAt])
  @@index([isRead])
  @@map("insights")
  @@schema("kora")
}

