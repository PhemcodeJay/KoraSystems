// ============================================================================
// Neobank — Plan Tiers
// ============================================================================

enum PlanTier {
  FREE
  STANDARD
  METAL

  @@schema("kora")
}

model UserPlan {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             PlanTier           @default(STANDARD) @map("tier")
  // Mirrors SME.subscriptionStatus for non-SME users, so every account has a
  // billable state. Entitlements are granted on tier, but only while status is
  // ACTIVE or PAST_DUE — a CANCELLED plan keeps its tier for display but
  // unlocks nothing.
  status           SubscriptionStatus @default(ACTIVE)
  cycle            String             @default("MONTHLY")
  amount           Decimal            @default(0) @db.Decimal(14, 2)
  currentPeriodEnd DateTime?          @map("current_period_end")
  cancelledAt      DateTime?          @map("cancelled_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("user_plans")
  @@schema("kora")
}

/// Append-only audit of every subscription change.
///
/// Billing state decides what a user can reach, so "who changed this tier, and
/// when" has to be answerable after the fact. Rows are never updated or
/// deleted: a change appends one and mutates UserPlan.
model SubscriptionEvent {
  id         String              @id @default(cuid())
  userId     String              @map("user_id")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NULL adminId for system-initiated events (expiry sweep, upgrade webhook).
  adminId    String?             @map("admin_id")
  fromTier   PlanTier?           @map("from_tier")
  toTier     PlanTier?           @map("to_tier")
  fromStatus SubscriptionStatus? @map("from_status")
  toStatus   SubscriptionStatus? @map("to_status")
  amount     Decimal?            @db.Decimal(14, 2)
  cycle      String?
  reason     String?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("subscription_events")
  @@schema("kora")
}

// ============================================================================
// Growth — AI sales agent (lead pipeline + outreach email audit)
// ============================================================================

/// Where a lead came from. `AI_SUGGESTED` rows are model output: contact
/// details are best-guesses until a human confirms them, which is what the
/// `Lead.verified` flag tracks.
enum LeadSource {
  MANUAL
  AI_SUGGESTED
  IMPORTED
  INBOUND

  @@schema("kora")
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  CONVERTED
  LOST

  @@schema("kora")
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED

  @@schema("kora")
}

/// One row per prospect in the sales pipeline.
///
/// Ownership is two-level on purpose: `ownerUserId` scopes the lead to the
/// person working it (which is what the routes filter on today), while `smeId`
/// stamps it with the business so org-level sharing arrives with multi-tenancy
/// rather than needing a data migration.
model Lead {
  id          String  @id @default(cuid())
  ownerUserId String  @map("owner_user_id")
  owner       User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  smeId       String? @map("sme_id")
  sme         SME?    @relation(fields: [smeId], references: [id], onDelete: SetNull)

  company     String
  contactName String? @map("contact_name")
  role        String?
  email       String?
  phone       String?
  city        String?
  country     String  @default("Kenya")

  source      LeadSource @default(MANUAL)
  status      LeadStatus @default(NEW)
  // 0-100 fit score. NULL means "not scored yet" — distinct from a low score,
  // so the batch agent can find its queue with `score IS NULL`.
  score       Int?
  scoreReason String?    @map("score_reason")
  notes       String?
  // True once a human confirmed the contact details. AI-suggested leads start
  // false; sending to an unverified address is how a domain gets flagged.
  verified    Boolean    @default(false)

  lastEmailedAt DateTime? @map("last_emailed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  emails OutreachEmail[]

  @@index([ownerUserId, status])
  @@index([ownerUserId, score])
  @@map("leads")
  @@schema("kora")
}

/// An email drafted or sent to a lead.
///
/// Append-only in spirit: `SENT` rows record what actually left the building
/// (`provider` is `smtp` or `simulated`, mirroring how the M-Pesa transactions
/// record `simulated` so a demo can never be mistaken for money that moved).
model OutreachEmail {
  id     String @id @default(cuid())
  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject   String
  body      String
  status    EmailStatus @default(DRAFT)
  // "smtp" when a real transport accepted it, "simulated" for demo sends.
  provider  String?
  messageId String?     @map("message_id")
  error     String?
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([leadId, status])
  @@map("outreach_emails")
  @@schema("kora")
}
