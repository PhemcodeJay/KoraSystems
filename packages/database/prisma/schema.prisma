// ============================================================================
// Unified ledger (double entry)
// ============================================================================

// Transaction is the header. Every movement posts at least one
// LedgerEntry; debits must equal credits per transaction, which is what
// stops admin reports double counting across Sale/Loan/Savings/BNPL.
model Transaction {
  id          String  @id @default(cuid())
  reference   String  @unique
  type        String
  description String?
  // PLATFORM_FLOAT | SME_WALLET | SUPPLIER_PAYABLE | LOAN_PRINCIPAL |
  // LOAN_RECEIVABLE | SAVINGS | BNPL_RECEIVABLE | REVENUE | CUSTOMER_WALLET
  accountCode String  @map("account_code")
  amount      Decimal @db.Decimal(14, 2)
  currency    String  @default("KES")
  smeId       String? @map("sme_id")
  customerId  String? @map("customer_id")
  // Set when the row was written by SimulatedProvider / demo seed.
  // Admin surfaces MUST badge these so demo data is never read as real money.
  simulated   Boolean @default(false)
  metadata    Json?

  // FKs for the one-to-many relations (a posting can cover many repayments
  // or installments). Sale and SavingsTransaction are one-to-one, so their
  // FK lives on the domain side instead.
  loanId            String? @map("loan_id")
  repaymentId       String? @map("repayment_id")
  bnplInstallmentId String? @map("bnpl_installment_id")

  entries         LedgerEntry[]
  // Reporting relation. smeId is a plain column (a posting can outlive the
  // SME it touched), so this is a read-only join. For customerId the
  // existing `customerWallet` relation already holds the FK, so it is reused
  // rather than declaring a second one on the same column.
  smeOwner        SME?                @relation("SmeTransactions", fields: [smeId], references: [id], onDelete: SetNull)
  // Inverses of the domain-side FKs (Sale.transactionId etc). For these the
  // owning side carries `fields`, so these must not.
  sale            Sale?               @relation("SaleTransaction")
  loan            Loan?               @relation("LoanTransactions", fields: [loanId], references: [id], onDelete: SetNull)
  repayment       Repayment?          @relation("RepaymentTransactions", fields: [repaymentId], references: [id], onDelete: SetNull)
  savingsTxn      SavingsTransaction? @relation("SavingsTransactionTxn")
  bnplInstallment BNPLInstallment?    @relation("BNPLInstallmentTransactions", fields: [bnplInstallmentId], references: [id], onDelete: SetNull)
  customerWallet  Customer?           @relation("CustomerWallet", fields: [customerId], references: [id], onDelete: SetNull)

  postedAt  DateTime @default(now()) @map("posted_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountCode, postedAt])
  @@index([smeId])
  @@index([type, postedAt])
  @@index([loanId])
  @@index([repaymentId])
  @@index([bnplInstallmentId])
  @@map("transactions")
  @@schema("kora")
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String          @map("transaction_id")
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountCode   String          @map("account_code")
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(14, 2)
  narration     String?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([accountCode])
  @@map("ledger_entries")
  @@schema("kora")
}

// ============================================================================
// AI
// ============================================================================

model CreditScore {
  id              String          @id @default(cuid())
  smeId           String          @map("sme_id")
  sme             SME             @relation(fields: [smeId], references: [id], onDelete: Cascade)
  loanId          String?         @map("loan_id")
  loan            Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
  // 0 - 1000
  score           Int
  riskLevel       CreditRiskLevel @map("risk_level")
  maxLoan         Decimal         @map("max_loan") @db.Decimal(14, 2)
  interestRate    Decimal         @map("interest_rate") @db.Decimal(7, 4)
  explanation     String
  recommendations String[]
  // Per-factor breakdown: sales consistency, revenue growth, volume,
  // retention, payment history, business age, inventory turnover,
  // debt-to-income, savings behaviour, supplier relations.
  // Milestone 1 writes deterministic placeholder factors; Milestone 2
  // swaps the computation without changing this shape.
  factors         Json
  model           String          @default("deterministic-v1")
  isPlaceholder   Boolean         @default(true) @map("is_placeholder")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([smeId, createdAt])
  @@map("credit_scores")
  @@schema("kora")
}

model Insight {
  id       String      @id @default(cuid())
