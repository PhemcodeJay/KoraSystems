// Kora lives in its own schema so it never collides with the 24 existing
// SalesPilot tables in neondb's public schema (customers, products, sales,
// users, invoices, payments, suppliers, subscriptions, reports).
generator client {
  provider = "prisma-client-js"
  // Co-locate the generated client with this package so its engine lookup
  // (relative to the client package) survives the app's server bundle.
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["kora"]
}

enum UserRole {
  SME
  SUPPLIER
  CUSTOMER
  ADMIN

  @@schema("kora")
}

enum OnboardingStep {
  BUSINESS_INFO
  PRODUCTS
  PAYMENTS
  COMPLETE

  @@schema("kora")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@schema("kora")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  // Trialing tenants behave like ACTIVE until `trialEndsAt`. Kept as its own
  // status so the UI can say "14 days left in trial" instead of "active".
  TRIALING

  @@schema("kora")
}

/// Role a team seat holds inside one SME tenant. Owner-only actions
/// (billing, inviting owners) check for OWNER; day-to-day management allows
/// OWNER + MANAGER; till work allows all three.
enum SmeMemberRole {
  OWNER
  MANAGER
  CASHIER

  @@schema("kora")
}

/// Billing cadence for a tenant subscription. Stored as an enum (not a free
/// string) so a typo can never create a "MONTLY" plan that bills forever.
enum BillingCycle {
  MONTHLY
  YEARLY

  @@schema("kora")
}

enum LoanStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  DISBURSEMENT_PENDING
  DISBURSED
  REPAYING
  SETTLED
  DEFAULTED
  // Dev default: real money movement is disabled until a licensed
  // partner is in place. See packages/disbursement.
  BLOCKED_NO_PARTNER

  @@schema("kora")
}

enum RepaymentStatus {
  PENDING
  PAID
  // A due date has passed with no payment recorded. Kept distinct from
  // FAILED (an attempted payment that errored) so default tracking can
  // query overdue instalments directly.
  OVERDUE
  FAILED
  WAIVED

  @@schema("kora")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED

  @@schema("kora")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  DUE
  OVERDUE
  VOID

  @@schema("kora")
}

enum SavingsTxnType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  FEE
  ADJUSTMENT

  @@schema("kora")
}

enum BnplStatus {
  PENDING
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED

  @@schema("kora")
}

enum InstallmentStatus {
  SCHEDULED
  PAID
  OVERDUE
  FAILED

  @@schema("kora")
}

enum PaymentMethod {
  MPESA_STK
  MPESA_B2C
  WALLET
  CASH
  LOAN
  BNPL
  CARD

  @@schema("kora")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED

  @@schema("kora")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@schema("kora")
}

enum InsightType {
  CREDIT
  FORECAST
  REVENUE
  INVENTORY
  CUSTOMER
  GENERAL

  @@schema("kora")
}

enum NotificationType {
  LOAN_UPDATE
  BNPL_UPDATE
  ORDER_UPDATE
  PAYMENT
  INSIGHT
  SYSTEM

  @@schema("kora")
}

enum CreditRiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@schema("kora")
}

// ============================================================================
// Identity
// ============================================================================

// Auth provider of record is Supabase; this table is the Neon-side mirror
// keyed by the Supabase auth user id. Role lives here, not in Supabase.
model User {
  id                 String    @id @default(cuid())
  authUserId         String    @unique @map("auth_user_id")
  email              String    @unique
  phone              String?   @unique
  fullName           String    @map("full_name")
  role               UserRole  @default(CUSTOMER)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  // scrypt hash with a per-password random salt, encoded
  // `scrypt$N$r$p$<salt>$<hash>`. NULL for accounts whose password lives
  // solely in Supabase Auth, which is the production path — the column is
  // nullable so those users keep working. Never selected into a response.
  passwordHash       String?   @map("password_hash")
  // Set when an ADMIN resets a password, forcing a change at next sign-in.
  // Clearing it is the entire "change your password" flow.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sme           SME?
  supplier      Supplier?
  customer      Customer?
  notifications Notification[]

  // Secondary roles beyond `role`. An SME on a paid tier can also sell as a
  // supplier and buy as a customer, which a single-value `role` cannot
  // express. `role` stays authoritative for the primary role; this table
  // carries the extras so downgrading a tier can revoke them without
  // touching the primary role or any of its data.
  roleAssignments    UserRoleAssignment[]
  plan               UserPlan?
  subscriptionEvents SubscriptionEvent[]
  smeMemberships     SmeMember[]
  // Sales-agent pipeline. `owner` is the user who works the lead; `sme` ties it
  // to the business so a future team seat inherits the pipeline instead of it
  // being trapped on one person's account.
  leads              Lead[]
  // Neobank surfaces. Opposite sides of the `user` relation on Account, Card,
  // Investment and InsurancePolicy — without these Prisma cannot resolve the
  // relation and the client cannot generate at all.
  accounts           Account[]
  cards              Card[]
  investments        Investment[]
  insurancePolicies  InsurancePolicy[]
  // Neobank crypto balances — one row per asset held.
  cryptoWallets      CryptoWallet[]

  @@index([role])
  @@map("users")
  @@schema("kora")
}

// ============================================================================
// Roles — secondary role assignment
// ============================================================================

/// A secondary role granted to a user, above their primary `User.role`.
///
/// Grants are additive and data-preserving: revoking a role removes the
/// capability but leaves the SME / Supplier / Customer rows and their history
/// in place, so a downgrade never destroys what the user built.
model UserRoleAssignment {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       UserRole
  // Plan tier that entitled this role, for display and audit only. Revocation
  // is driven by the user's current tier, not by this column.
  grantedVia PlanTier? @map("granted_via")
  // Why it was granted — "METAL upgrade", "admin grant". Free text for the
  // admin audit view; never shown to the user.
  reason     String?
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@map("user_role_assignments")
  @@schema("kora")
}

// ============================================================================
// SME
// ============================================================================

model SME {
  id                 String           @id @default(cuid())
  userId             String           @unique @map("user_id")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String           @map("business_name")
  registrationNumber String?          @map("registration_number")
  businessType       String?          @map("business_type")
  county             String?
  town               String?
  address            String?
  yearsInBusiness    Int?             @map("years_in_business")
  onboardingStep     OnboardingStep   @default(BUSINESS_INFO) @map("onboarding_step")
  onboardingStatus   OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  mpesaTill          String?          @map("mpesa_till")
  mpesaPaybill       String?          @map("mpesa_paybill")

  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionPaidAt DateTime?          @map("subscription_paid_at")
  subscriptionAmount Decimal            @default(2500) @map("subscription_amount") @db.Decimal(14, 2)
  subscriptionCycle  String             @default("MONTHLY") @map("subscription_cycle")

  // ── SaaS tenant billing (source of truth lives on SmeSubscription) ──────
  // The flat `subscriptionStatus/Amount/Cycle` columns above are legacy
  // per-owner mirrors, kept so old reads keep working. New code resolves
  // tier/status from `subscriptions` (tenant-level) with fallback to the
  // owner's UserPlan, then to these mirrors. Members join via `members`;
  // every charge/refund is an auditable SmeBillingEvent row.
  members       SmeMember[]
  subscriptions SmeSubscription[]
  billingEvents SmeBillingEvent[]

  tills         Till[]
  products      Product[]
  sales         Sale[]
  orders        Order[]
  invoices      Invoice[]
  loans         Loan[]
  savings       Savings?
  creditScores  CreditScore[]
  insights      Insight[]
  notifications Notification[]
  bnplPlans     BNPL[]
  ledgerEntries Transaction[]  @relation("SmeTransactions")
  leads         Lead[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([onboardingStatus])
  @@index([subscriptionStatus])
  @@map("smes")
  @@schema("kora")
}

/// One seat inside an SME tenant. The owner row is created at registration;
/// further seats are invites accepted by email. `userId` is nullable so an
/// invite can exist before the person has an account — it is bound on accept.
model SmeMember {
  id        String       @id @default(cuid())
  smeId     String       @map("sme_id")
  sme       SME          @relation(fields: [smeId], references: [id], onDelete: Cascade)
  userId    String?      @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  role      SmeMemberRole @default(CASHIER)
  isActive  Boolean      @default(true) @map("is_active")
  invitedBy String?      @map("invited_by")
  joinedAt  DateTime     @default(now()) @map("joined_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([smeId, email])
  @@index([smeId, isActive])
  @@index([userId])
  @@map("sme_members")
  @@schema("kora")
}

/// Tenant-level subscription. Exactly one ACTIVE-or-TRIALING row per SME at a
/// time is enforced in application code (not a partial unique index, which
/// Neon/Postgres would allow but Prisma cannot express portably). History is
/// preserved: downgrades/cancels close the old row and open a new one.
model SmeSubscription {
  id               String             @id @default(cuid())
  smeId            String             @map("sme_id")
  sme              SME                @relation(fields: [smeId], references: [id], onDelete: Cascade)
  tier             PlanTier           @default(FREE)
  status           SubscriptionStatus @default(TRIALING)
  cycle            BillingCycle       @default(MONTHLY)
  amount           Decimal            @default(0) @db.Decimal(14, 2)
  trialEndsAt      DateTime?          @map("trial_ends_at")
  currentPeriodEnd DateTime?          @map("current_period_end")
  cancelledAt      DateTime?          @map("cancelled_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([smeId, status])
  @@index([status, currentPeriodEnd])
  @@map("sme_subscriptions")
  @@schema("kora")
}

/// Append-only billing ledger for a tenant: every subscription charge,
/// refund, trial start and admin change lands here so "who billed what, when"
/// is always answerable. `transactionReference` links to the double-entry
/// Transaction when money actually moved through the ledger.
model SmeBillingEvent {
  id                   String   @id @default(cuid())
  smeId                String   @map("sme_id")
  sme                  SME      @relation(fields: [smeId], references: [id], onDelete: Cascade)
  actorUserId          String?  @map("actor_user_id")
  fromTier             PlanTier? @map("from_tier")
  toTier               PlanTier? @map("to_tier")
  fromStatus           SubscriptionStatus? @map("from_status")
  toStatus             SubscriptionStatus? @map("to_status")
  amount               Decimal  @default(0) @db.Decimal(14, 2)
  cycle                BillingCycle? @map("billing_cycle")
  reason               String?
  mpesaReceipt         String?  @map("mpesa_receipt")
  transactionReference String?  @map("transaction_reference")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([smeId, createdAt])
  @@map("sme_billing_events")
  @@schema("kora")
}

// ============================================================================
// Supplier
// ============================================================================

model Supplier {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String  @map("company_name")
  registrationNo String? @map("registration_no")
  contactEmail   String? @map("contact_email")
  contactPhone   String? @map("contact_phone")
  county         String?
  town           String?
  address        String?
  // 0.00 - 5.00, denormalised average of ratings
  rating         Decimal @default(0) @db.Decimal(3, 2)
  ratingCount    Int     @default(0) @map("rating_count")
  mpesaPaybill   String? @map("mpesa_paybill")
  mpesaTill      String? @map("mpesa_till")

  products Product[]
  orders   Order[]
  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
  @@schema("kora")
}

// ============================================================================
// Customer
// ============================================================================

model Customer {
  id       String  @id @default(cuid())
  userId   String  @unique @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String  @map("full_name")
  phone    String? @unique
  email    String? @unique
  county   String?
  town     String?

  loyaltyPoints Int     @default(0) @map("loyalty_points")
  loyaltyTier   String  @default("BRONZE") @map("loyalty_tier")
  totalSpend    Decimal @default(0) @map("total_spend") @db.Decimal(14, 2)
  purchaseCount Int     @default(0) @map("purchase_count")

  // Customer-side credit standing, distinct from SME credit score
  creditLimit Decimal @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditUsed  Decimal @default(0) @map("credit_used") @db.Decimal(14, 2)
  creditScore Int?    @map("credit_score")

  sales         Sale[]
  bnplPlans     BNPL[]
  walletEntries Transaction[]  @relation("CustomerWallet")
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@map("customers")
  @@schema("kora")
}

// ============================================================================
// Catalog
// ============================================================================

model Product {
  id                String    @id @default(cuid())
  smeId             String    @map("sme_id")
  sme               SME       @relation(fields: [smeId], references: [id], onDelete: Cascade)
  supplierId        String?   @map("supplier_id")
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  sku               String    @unique
  barcode           String?   @unique
  category          String?
  price             Decimal   @db.Decimal(14, 2)
  costPrice         Decimal?  @map("cost_price") @db.Decimal(14, 2)
  stockQuantity     Int       @default(0) @map("stock_quantity")
  lowStockThreshold Int       @default(10) @map("low_stock_threshold")
  reorderLevel      Int       @default(10) @map("reorder_level")
  imageUrl          String?   @map("image_url")
  isActive          Boolean   @default(true) @map("is_active")
  // Local mirror id from the offline POS Dexie store
  clientId          String?   @unique @map("client_id")

  saleItems    SaleItem[]
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]
  bnplItems    BNPLItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([smeId, isActive])
  @@index([barcode])
  @@index([sku])
  @@map("products")
  @@schema("kora")
}

// ============================================================================
// Sales
// ============================================================================

model Sale {
  id            String        @id @default(cuid())
  smeId         String        @map("sme_id")
  sme           SME           @relation(fields: [smeId], references: [id], onDelete: Cascade)
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(14, 2)
  costTotal     Decimal?      @map("cost_total") @db.Decimal(14, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(COMPLETED) @map("payment_status")
  // Commission the platform takes (e.g. KES 5 SME fee)
  platformFee   Decimal       @default(0) @map("platform_fee") @db.Decimal(14, 2)
  mpesaReceipt  String?       @map("mpesa_receipt")
  // Idempotency key from the offline POS so replayed syncs never double-post
  clientId      String?       @unique @map("client_id")
  notes         String?
  // True when the row was written with no real money movement
  simulated     Boolean       @default(false)

  items         SaleItem[]
  // One-to-one link to the ledger header. FK lives here (the owning side);
  // Transaction.sale is the inverse with no `fields`.
  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation("SaleTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  soldAt    DateTime @default(now()) @map("sold_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([smeId, soldAt])
  @@index([smeId])
  @@index([customerId])
  @@map("sales")
  @@schema("kora")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(14, 2)
  costPrice Decimal? @map("cost_price") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
  @@schema("kora")
}

// ============================================================================
// Orders (SME -> Supplier)
// ============================================================================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")
  smeId       String      @map("sme_id")
  sme         SME         @relation(fields: [smeId], references: [id], onDelete: Cascade)
  supplierId  String      @map("supplier_id")
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  notes       String?
  placedAt    DateTime    @default(now()) @map("placed_at")
  confirmedAt DateTime?   @map("confirmed_at")
  shippedAt   DateTime?   @map("shipped_at")
  deliveredAt DateTime?   @map("delivered_at")

  items    OrderItem[]
  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([smeId, status])
  @@index([supplierId, status])
  @@map("orders")
  @@schema("kora")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)

  @@index([orderId])
  @@map("order_items")
  @@schema("kora")
}

// ============================================================================
// Invoices
// ============================================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @map("invoice_number")
  smeId         String        @map("sme_id")
  sme           SME           @relation(fields: [smeId], references: [id], onDelete: Cascade)
  supplierId    String?       @map("supplier_id")
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderId       String?       @map("order_id")
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  dueDate       DateTime?     @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  simulated     Boolean       @default(false)

  items InvoiceItem[]

  issuedAt  DateTime @default(now()) @map("issued_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([smeId, status])
  @@index([supplierId])
  @@map("invoices")
  @@schema("kora")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_items")
  @@schema("kora")
}

// ============================================================================
// Credit
// ============================================================================

model Loan {
  id           String     @id @default(cuid())
  loanNumber   String     @unique @map("loan_number")
  smeId        String     @map("sme_id")
  sme          SME        @relation(fields: [smeId], references: [id], onDelete: Cascade)
  principal    Decimal    @db.Decimal(14, 2)
  interestRate Decimal    @map("interest_rate") @db.Decimal(7, 4)
  termMonths   Int        @map("term_months")
  totalPayable Decimal    @map("total_payable") @db.Decimal(14, 2)
  amountRepaid Decimal    @default(0) @map("amount_repaid") @db.Decimal(14, 2)
  status       LoanStatus @default(PENDING_REVIEW)
  purpose      String?

  // Credit decision snapshot, captured at application time
  creditScoreAtApplication Int?     @map("credit_score_at_application")
  maxApprovedAmount        Decimal? @map("max_approved_amount") @db.Decimal(14, 2)

  // Disbursement
  disbursedAt     DateTime? @map("disbursed_at")
  disbursementRef String?   @map("disbursement_ref")
  // Why disbursement is blocked, e.g. "No licensed disbursement partner configured"
  blockedReason   String?   @map("blocked_reason")
  simulated       Boolean   @default(false)

  decisionReason   String?   @map("decision_reason")
  decidedAt        DateTime? @map("decided_at")
  decidedByUserId  String?   @map("decided_by_user_id")
  firstPaymentDate DateTime? @map("first_payment_date")
  maturityDate     DateTime? @map("maturity_date")

  repayments   Repayment[]
  creditScores CreditScore[]
  transactions Transaction[] @relation("LoanTransactions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([smeId, status])
  @@index([status])
  @@map("loans")
  @@schema("kora")
}

model Repayment {
  id                String          @id @default(cuid())
  loanId            String          @map("loan_id")
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int             @map("installment_number")
  amountDue         Decimal         @map("amount_due") @db.Decimal(14, 2)
  principalPaid     Decimal         @default(0) @map("principal_paid") @db.Decimal(14, 2)
  interestPaid      Decimal         @default(0) @map("interest_paid") @db.Decimal(14, 2)
  amountPaid        Decimal         @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status            RepaymentStatus @default(PENDING)
  dueDate           DateTime        @map("due_date")
  paidAt            DateTime?       @map("paid_at")
  mpesaReceipt      String?         @map("mpesa_receipt")
  simulated         Boolean         @default(false)

  transactions Transaction[] @relation("RepaymentTransactions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loanId, installmentNumber])
  @@index([loanId, status])
  @@map("repayments")
  @@schema("kora")
}

