# ============================================================================
# KoraSystems - Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# Database (Neon PostgreSQL)
#
# SECURITY: this template must NEVER contain a real credential. A Neon password
# committed here is readable by anyone who clones the repo, and `neondb_owner`
# is the instance owner — it can drop or alter every table in the database,
# including tables belonging to other applications sharing the instance.
# Rotate any credential that has ever appeared in this file.
#
#   psql "$DATABASE_URL" -c "CREATE ROLE kora_app LOGIN PASSWORD '<generate>';"
#   GRANT USAGE ON SCHEMA kora TO kora_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA kora TO kora_app;
#
# Use the scoped `kora_app` role above, NOT the instance owner, in any shared
# environment.
DATABASE_URL="postgresql://kora_app:REPLACE_ME@ep-XXXXXXXX-XXXX-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://kora_app:REPLACE_ME@ep-XXXXXXXX-XXXX-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_MS=10000

# Auth
# Generate with: openssl rand -base64 48
#
# SECURITY: must be a real random value of at least 32 characters. The session
# cookie is HMAC-signed with this, and the app refuses to start on a known
# placeholder — a guessable value lets anyone forge an ADMIN session cookie.
# Never reuse this value across environments.
SESSION_SECRET="REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_base64_48"
JWT_SECRET="REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_base64_48"

# Demo mode.
# When set, ANY active account in the database can sign in with this single
# shared password, and the account's real role is honoured. Convenient for
# demos and review. UNSET (or empty) it for production, so `authenticate()`
# falls through to Supabase Auth and real per-user passwords.
KORA_DEMO_PASSWORD="Demo@1234"
# Second production opt-in for demo mode. In production the shared password
# above is IGNORED unless this is also set to "true", so copying a demo .env
# onto a production host can no longer enable it by accident.
KORA_ALLOW_DEMO_LOGIN=""

# Supabase (Auth)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# M-Pesa Daraja (Sandbox)
# NOTE: the code reads MPESA_ENVIRONMENT (not MPESA_ENV). Any value other
# than exactly "production" is treated as sandbox.
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""
MPESA_CALLBACK_URL="https://your-tunnel.example.com/api/mpesa/callback"
MPESA_RESULT_URL="https://your-tunnel.example.com/api/mpesa/b2c/result"
MPESA_TIMEOUT_URL="https://your-tunnel.example.com/api/mpesa/b2c/timeout"

# AI
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Preferred model provider for the sales agent: openai | gemini. Empty means
# "first key found". Scoring and drafting fall back to local
# heuristics/templates when no key is set, but AI sourcing needs a provider.
AI_PROVIDER=""

# Outbound sales email (growth agent). With no SMTP configured, sends are
# logged as `simulated` — mirroring DISBURSEMENT_PROVIDER — so a demo never
# delivers real mail. Set EMAIL_PROVIDER=simulated to force demo mode even
# with credentials present; =smtp fails loudly if they are missing.
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# App
# ── One origin ─────────────────────────────────────────────────────────────
# The platform is a single Next.js app (apps/admin) serving every product:
# SalesPilot, SwiftPOS, Neobank, the user dashboard and the admin console are
# ROUTES on it, not separate servers. That is why there is one port.
#
# PORT is the only place the port is declared. `next dev` / `next start` read
# it and fall back to 3000, so nothing else needs to change to move the app.
PORT="3000"
# Canonical origin for Open Graph / social cards. Derive it from PORT; when
# unset, next.config.mjs builds it from PORT automatically. Keeping them in
# step matters — a mismatch yields canonical URLs pointing at a dead port.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Disbursement
DISBURSEMENT_PROVIDER="simulated"

# Demo seed
KORA_SEED_DEMO="true"

# ── Production checklist ────────────────────────────────────────────────
# Before going live, confirm all of the following:
#   [ ] KORA_DEMO_PASSWORD removed — a shared password accepts every account
#       (in production it now also needs KORA_ALLOW_DEMO_LOGIN=true; remove both)
#   [ ] SESSION_SECRET and JWT_SECRET are fresh random values, not the template
#   [ ] NEXT_PUBLIC_APP_URL / KORA_PLATFORM_URL point at the real domains
#       (no localhost) — the Vite client apps resolve the API from these
#   [ ] MPESA_ENVIRONMENT=production with real Daraja credentials, or left at
#       sandbox with DISBURSEMENT_PROVIDER=simulated so no money can move
#   [ ] DISBURSEMENT_PROVIDER stays "simulated" until a licensed Kenyan
#       disbursement partner is contracted (CBK digital-credit perimeter)
#   [ ] DATABASE_URL credentials rotated if this template was ever filled in
