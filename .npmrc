telemetry.enabled=false

# ── Content store location ────────────────────────────────────────────────
# The global store at C:\Users\Phemcode\AppData\Local\pnpm\store\v3 is damaged
# on this machine: `pnpm store status` fails with ENOENT and installs from it
# silently produce EMPTY package directories, which surface much later as
# `Cannot find module 'react'` / missing next/dist internals. Keeping the store
# inside the repo means a fresh one is used and it can be deleted and rebuilt
# without touching the global one.
store-dir=.pnpm-store-fresh

# ── Windows reliability ────────────────────────────────────────────────────
# Packages here were repeatedly found EMPTY (0 files) in node_modules/.pnpm,
# which broke `next build` with:
#     Cannot find module '.../next/dist/compiled/jest-worker/processChild.js'
#
# Cause: pnpm hardlinks packages out of its global store (files showed nlink=2).
# When an install ran while a `next start` / `next build` still held those files
# open, Windows refused the deletes with EPERM. pnpm swallowed the failures and
# reported success, leaving the package directory present but empty — so the
# only symptom was the module-not-found error at the next build.
#
# `package-import-method=copy` makes pnpm copy instead of hardlink. It costs more
# disk and a slower install, but a locked file can no longer take the rest of
# the package with it, and an interrupted install no longer half-applies.
package-import-method=copy

# Fail loudly on a damaged store rather than installing from it silently.
verify-store-integrity=true
